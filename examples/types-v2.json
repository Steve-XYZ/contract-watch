{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders Types API",
    "version": "2.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "responses": {
          "200": { "description": "ok" }
        }
      },
      "post": {
        "operationId": "createOrder",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "ok" }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amount": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
