{
  "openapi": "3.1.0",
  "info": {
    "title": "Payments Policies API",
    "version": "1.1.0"
  },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["note"],
                  "properties": {
                    "id": { "type": "string" },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "get": {
        "operationId": "listPayments",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amount": { "type": "number" },
                    "settledAt": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/refunds": {
      "get": {
        "operationId": "listRefunds",
        "summary": "Reembolsos disponibles",
        "description": "Devuelve el detalle completo de cada reembolso.",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
